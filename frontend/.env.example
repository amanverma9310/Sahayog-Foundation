# Base URL of the backend API — this is live and connected (see src/lib/api.js)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay public key (safe for frontend — secret stays on backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Google Maps JS API key (for the Contact page map, optional)
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics measurement ID
VITE_GA_MEASUREMENT_ID=

# Public site URL (used for canonical/OG tags)
VITE_SITE_URL=https://www.example-ngo.org
