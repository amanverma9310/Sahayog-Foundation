# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins in production
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.example-ngo.org

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/sahayog?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Admin seed (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@sahayogfoundation.org
SEED_ADMIN_PASSWORD=ChangeThisImmediately123!
SEED_ADMIN_NAME=Super Admin

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP - works with Gmail, SendGrid, Resend SMTP, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@sahayogfoundation.org
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM_NAME=Sahayog Foundation
EMAIL_FROM_ADDRESS=notifications@sahayogfoundation.org
ADMIN_NOTIFICATION_EMAIL=admin@sahayogfoundation.org

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
